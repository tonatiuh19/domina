# Public site origin for production emails / absolute links.
# Local checkout redirects use the browser Origin (localhost) even if this is set to prod.
VITE_PUBLIC_SITE_URL=http://localhost:8080

# Session pepper. Use a long random value in every environment.
JWT_SECRET=replace-with-a-long-random-string

# TiDB Cloud Serverless
DB_HOST=
DB_PORT=4000
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSL=true

# Resend. Tests and @example.test addresses never send.
RESEND_API_KEY=
SMTP_FROM="DOMINA <hello@example.com>"

# Optional cron protection
CRON_SECRET=

# First staff owner. Used only when the admins table is empty.
BOOTSTRAP_ADMIN_EMAIL=

# Stripe test keys. STRIPE_SECRET_KEY / VITE_STRIPE_PUBLISHABLE_KEY are accepted as fallbacks.
# Do not point this app at another product's live account.
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_PUBLISHABLE_KEY=
VITE_STRIPE_TEST_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VITE_STRIPE_PUBLISHABLE_KEY=

# Disrupting Labs CDN (same enteratelo-php stack as athlete-hub).
# Course images use uploadImages.php (no secret). PDFs/files need CDN_UPLOAD_SECRET.
CDN_UPLOAD_URL=https://disruptinglabs.com/data/api/uploadFiles.php
CDN_UPLOAD_SECRET=
